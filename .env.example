# Copy to .env, then set only the credential for your chosen provider.
# Providers: jev (TypeSafe, default), openrouter, openai, custom.
LINTPAL_PROVIDER=jev
# Model defaults: jev/custom = jev-latest; openrouter = typesafe/jev-1.13.
# OpenAI requires an explicit model; gpt-6-luna is supported by Decisions API.
# LINTPAL_MODEL=your-model-id
TYPESAFE_API_KEY=

# OpenRouter: set LINTPAL_PROVIDER=openrouter and its key.
# OPENROUTER_API_KEY=

# OpenAI: official https://api.openai.com/v1/decisions (limited preview).
# Set LINTPAL_PROVIDER=openai, OPENAI_API_KEY and LINTPAL_MODEL.
# OPENAI_API_KEY=
# LINTPAL_MODEL=gpt-6-luna

# Custom: set LINTPAL_PROVIDER=custom and your own key variable.
# LINTPAL_BASE_URL=https://decisions.example.test/api
# LINTPAL_API_PATH=/v1/decisions
# LINTPAL_AUTH_TOKEN_ENV=LINTPAL_TOKEN
# LINTPAL_TOKEN=
# Without LINTPAL_API_PATH, custom appends /v1/systemone.
