# Copy to .env, then set only the credential for your chosen provider.
LINTPAL_PROVIDER=jev
# Optional model override; otherwise LintPal uses the selected provider default.
# jev/custom: jev-latest; openrouter: typesafe/jev-1.13
# LINTPAL_MODEL=jev-latest
TYPESAFE_API_KEY=

# For OpenRouter, change LINTPAL_PROVIDER to openrouter and set its key instead.
# OPENROUTER_API_KEY=
